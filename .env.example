# ==============================================================================
# ESPReL Environment Configuration Template
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าให้ตรงกับเครื่องเซิร์ฟเวอร์/ฐานข้อมูลจริง
# cp .env.example .env
# ==============================================================================

# PostgreSQL Database (ESPReL)
DB_PG_HOST=localhost
DB_PG_PORT=5432
DB_PG_DATABASE=ESPReL
DB_PG_USER=postgres
DB_PG_PASSWORD=your_pg_password

# MySQL Database (db_user)
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=db_user
DB_MYSQL_USER=your_mysql_user
DB_MYSQL_PASSWORD=your_mysql_password

# MS SQL Server (NUDB - Student Database)
DB_MSSQL_HOST=10.10.22.9
DB_MSSQL_PORT=1433
DB_MSSQL_DATABASE=NUDB
DB_MSSQL_USER=your_mssql_user
DB_MSSQL_PASSWORD=your_mssql_password

# MS SQL Server (Student Analytics)
DB_MSSQL_ANALYTICS_SERVER=10.10.98.203
DB_MSSQL_ANALYTICS_DATABASE=NUDB
DB_MSSQL_ANALYTICS_USER=your_analytics_user
DB_MSSQL_ANALYTICS_PASSWORD=your_analytics_password

# LDAP Authentication
LDAP_SERVER=ldap://10.10.10.71
LDAP_DOMAIN=@nu.local

# SMTP Email Service (Office 365 / SMTP Server)
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_ENCRYPTION=STARTTLS
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=your_email@domain.com
MAIL_FROM_NAME="ระบบจัดการเอกสารนักวิจัย"
MAIL_CC_DEFAULT=admin@domain.com

# Authorized Admin Usernames (comma-separated)
ADMIN_USERS=user1,user2,user3
